---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import DomainSection from "../components/DomainSection.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Navbar />

  <main class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-xl-7">
        <div class="text-center mb-4">
          <h1 class="display-6 fw-bold">1.111B Class Domain Generator</h1>
          <p class="text-secondary">Discover &amp; register rare numeric .xyz domains.</p>
        </div>

        <div class="d-grid mb-5">
          <button id="generate-btn" class="btn btn-primary btn-lg">✨ Generate &amp; Check Availability</button>
        </div>

        <DomainSection icon="🎲" label="Random" listId="random-list" />
        <DomainSection icon="⭐" label="Iconic" listId="iconic-list" />
        <DomainSection icon="🧮" label="Prime" listId="prime-list" />
        <DomainSection icon="📅" label="Year" listId="year-list" />
        <DomainSection icon="⚖️" label="Even / Odd" listId="evenodd-list" />
        <DomainSection icon="⭕" label="Round" listId="round-list" />
        <DomainSection icon="🔁" label="Palindrome" listId="palindrome-list" />
        <DomainSection icon="🟦" label="Perfect Square" listId="square-list" />
        <DomainSection icon="🍀" label="Lucky" listId="lucky-list" />
        <DomainSection icon="🪞" label="Mirror" listId="mirror-list" />
        <DomainSection icon="👼" label="Angel" listId="angel-list" />
        <DomainSection icon="🤖" label="Binary" listId="binary-list" />
        <DomainSection icon="🎯" label="Triples" listId="triples-list" />
        <DomainSection icon="🔢" label="Sequential" listId="sequential-list" />
        <DomainSection icon="👯" label="Pairs" listId="pairs-list" />
        <DomainSection icon="🔂" label="Repeater" listId="repeater-list" />
        <DomainSection icon="🧱" label="Solid" listId="solid-list" />
        <DomainSection icon="🐚" label="Fibonacci" listId="fibonacci-list" />
      </div>
    </div>
  </main>

  <Footer />

  <script>
    import "../scripts/main.js";
  </script>
</Layout>
